# Environment
NODE_ENV=development

# Ports
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002

# API Configuration
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Configuration (Public - SEGURO expor)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Configuration (Private - NUNCA com NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Only needed for legacy HS256 tokens. ES256/RS256 use the project JWKS.
SUPABASE_JWT_SECRET=

# Admin Authorization (Backend only - NUNCA com NEXT_PUBLIC_)
ADMIN_USER_ID=your-admin-user-uuid

# Redis Configuration (use single REDIS_URL for simplicity)
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# Internal Security
INTERNAL_API_SECRET=your-internal-secret-key-here

# Allowed dashboard origin in production
CORS_ORIGINS=https://painel.example.com
